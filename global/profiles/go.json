      "Bash(gofmt -l *)",
      "Bash(go list*)",
      "Bash(go mod verify)",
      "Bash(go mod tidy -diff)",
      "Bash(golangci-lint run*)",
      "Bash(govulncheck ./...)",
      "Bash(staticcheck ./...)"
    ]
  }
}
