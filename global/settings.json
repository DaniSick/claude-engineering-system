{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git show*)",
      "Bash(ls*)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(php -l *)",
      "Bash(./vendor/bin/phpstan *)",
      "Bash(./vendor/bin/psalm *)",
      "Bash(./vendor/bin/pest *)",
      "Bash(./vendor/bin/phpunit *)",
      "Bash(php artisan list*)",
      "Bash(php artisan route:list*)",
      "Bash(php artisan about)",
      "Bash(php artisan inspire)",
      "Bash(php artisan make:*)",
      "Bash(composer validate)",
      "Bash(composer show*)",
      "Bash(composer diagnose)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run type-check*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/secret-scan.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
